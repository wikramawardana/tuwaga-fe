# Central OIDC/SSO service
AUTH_URL=http://localhost:3001
AUTH_CLIENT_ID=your-central-oauth-client-id
AUTH_CLIENT_SECRET=your-central-oauth-client-secret

# Better Auth — this app's OWN auth database (never shared with other apps
# or the central auth service). Local dev: tuwaga_auth_dev.
BETTER_AUTH_SECRET=your-better-auth-secret
DATABASE_URL=postgresql://user:password@localhost:5432/tuwaga_auth_dev

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3004
NEXT_PUBLIC_API_URL=http://localhost:8004/api/v1
NODE_ENV=development
